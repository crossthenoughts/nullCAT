# ============================================================
# OS junk
# ============================================================
Thumbs.db
desktop.ini
.DS_Store

# ============================================================
# Runtime output + machine-local configs (never tracked; the
# tracked examples live in resources/ and deploy/*.example.json)
# ============================================================
logs/
**/config.json
**/host.json
**/rig.json
**/buttons.json
!resources/*.reference.json
!deploy/*.example.json

# Local gitleaks deny-patterns (personal SSIDs/hostnames/emails).
# Deliberately untracked: a tracked deny-list would publish the
# very strings it protects. See tools/git-hooks/pre-commit.
.gitleaks.local.toml

# ============================================================
# Ingestion inbox - files dropped here for Claude analysis,
# not durable repo artifacts.
# ============================================================
_ingest/
dist/

# Rig session logs dropped here for analysis (never published)
/rig-logs/
