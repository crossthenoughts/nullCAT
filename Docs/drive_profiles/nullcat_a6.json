{
  "name": "nullCAT A6-EC / AS715N standard",
  "firmware": "V512",
  "source": "configured drive dump (slave 1) vs fresh out-of-box (slave 4); see Docs/drive-reference/",
  "_notes": "clone[] = the 18 verified deliberate changes, values from the known-good configured drive. torqueOnly[] = additional one-time writes applied ONLY when the target slave is a torque axis per the rig config (position axes keep factory values). unlock gates the hidden carrier object. store is CiA-301 'save' (0x65766173). carrier is freshFromFactory-gated until the base-carrier param address is known (24kHz-fault guard).",
  "unlock": {
    "coe": "0x2000:0x32",
    "type": "u16",
    "value": 1107,
    "panel": "C00.31",
    "name": "factory unlock"
  },
  "store": {
    "coe": "0x1010:0x01",
    "type": "u32",
    "value": 1702257011,
    "name": "save to NVRAM (CiA-301 'save')"
  },
  "carrier": {
    "_warn": "ONLY valid effective carrier = 8 or 16 kHz. R22.38=1 doubles an 8 kHz base -> 16 kHz. If base is NOT factory 8 kHz this could create 24/32 kHz -> Er31.0/Er50.1. Gated on freshFromFactory until base-carrier param address is pinned.",
    "doubler": {
      "coe": "0x2022:0x39",
      "type": "u16",
      "value": 1,
      "panel": "R22.38",
      "name": "carrier doubler x2",
      "needsUnlock": true,
      "powerCycle": true
    },
    "base": {
      "coe": "UNKNOWN",
      "expectFactory8kHz": true,
      "_note": "base-carrier object address unconfirmed by the vendor; the doubler stays gated on --fresh"
    }
  },
  "perAxis": {
    "inertia": {
      "coe": "0x2000:0x07",
      "type": "u16",
      "baseline": 100,
      "panel": "C00.06",
      "autoId": "F30.10",
      "_note": "writes the factory baseline 100; inertia stays at 100 on all axes (the drive's auto-ID F30.10 is a motion-producing function and is not used)"
    },
    "notch1": {
      "freq": "0x2001:0x41",
      "width": "0x2001:0x42",
      "depth": "0x2001:0x43",
      "default": [
        7999,
        500,
        10
      ],
      "_note": "factory freq 8000 = parked/off; set <8000 to engage. Per-axis: measure each chirp."
    },
    "notch2": {
      "freq": "0x2001:0x44",
      "width": "0x2001:0x45",
