+/* ---- nullCAT: frames sent from helper threads ----------------------------
+ * pcap_sendpacket is a synchronous WriteFile to the Npcap driver, which
+ * completes it only once the NIC driver reports the transmit done. On the
+ * Intel I210/I211 under Windows 11 that report arrives up to 15 ms late
+ * while the frame itself left the card in microseconds, and the calling
+ * thread (the control loop) sat in the call for the whole of it (nullCAT
+ * trace, 2026-10-21: every stall was this wait). Here the caller hands the
+ * frame to one of a few sender threads and goes straight on to the receive.
+ * Each sender has its own pcap handle on the same adapter, because the
+ * driver takes one write at a time per handle: a sender still waiting for
+ * an old completion report does not hold the next frame up. The caller
+ * waits only until the sender has entered its write (tens of microseconds,
+ * OSHW_SEND_START_WAIT_US at most). That orders the hand-offs, not quite
+ * the writes: a sender marks itself started just before it calls into the
+ * driver, and a caller that gives up waiting goes on regardless, so two
+ * frames sent back to back by one thread could reach the driver swapped.
+ * nullCAT sends one frame per cycle from its loop, and each mailbox frame
+ * waits for its reply before the next goes, so it never sends two back to
+ * back. With every sender busy the frame goes the old way, inline.
+ * oshw_async_send = 0 restores the old path for comparison.
+ *
+ * A frame index is one of EC_MAXBUF (16) and comes round again 16 frames
+ * later. With the caller no longer waiting on the driver, 16 frames can be
+ * in flight after a run of late replies, and the oldest reply then carries
+ * the index of the frame just sent: SOEM would take it for the new reply,
+ * and from then on every cycle would read a reply 16 frames old (and, as
+ * the reply echoes the outputs it carried, write 16-frame-old outputs back
+ * into the process image). So every frame sent here carries a sequence tag
+ * in bytes 4-5 of its source address (slaves only touch bit 1 of byte 0),
+ * and a reply whose tag is not the latest one sent with its index is
+ * dropped before SOEM sees it. */
+#define OSHW_SENDERS            32
+#define OSHW_SEND_START_WAIT_US 500
+
+int oshw_async_send = 1;
+/* [0] frames handed to a sender, [1] sent inline (every sender busy),
+ * [2] callers that waited the full start wait without the sender starting,
+ * [3] replies dropped as stale (an older frame with the same index),
+ * [4] late replies: the latest frame with that index, but its caller had
+ *     already given up waiting (SOEM drops it; counted so the log can tell
+ *     "late" from "lost") */
+unsigned long oshw_async_stats[5] = { 0, 0, 0, 0, 0 };
+
+typedef struct
+{
+   pcap_t *sock;
+   uint8   buf[EC_BUFSIZE];
+   int     len;
+   HANDLE  go;
+   HANDLE  thread;
+   volatile LONG busy;      /* taken by a caller until the write returns */
+   volatile LONG started;   /* the sender has entered the write */
+   volatile LONG stop;
+} oshw_sender_t;
+
+/* Each sender is its own allocation, so one stuck in a write can be left to
+ * its thread (oshw_senders_close) while a later open starts fresh ones. */
+static oshw_sender_t *g_senders[OSHW_SENDERS];
+static int           g_sender_count = 0;
+static unsigned      g_sender_next  = 0;
+static LARGE_INTEGER g_qpf;
+static int           g_tagging = 0;          /* frames carry the sequence tag */
+static volatile LONG g_tag_next = 0;
+static uint16        g_tag[EC_MAXBUF];        /* latest tag sent with each index */
+
+static DWORD WINAPI oshw_sender_main(LPVOID arg)
+{
+   oshw_sender_t *s = (oshw_sender_t *)arg;
+   for (;;)
+   {
+      WaitForSingleObject(s->go, INFINITE);
+      if (s->stop) break;
+      InterlockedExchange(&s->started, 1);
+      pcap_sendpacket(s->sock, s->buf, s->len);
+      InterlockedExchange(&s->busy, 0);
+   }
+   return 0;
+}
+
+static void oshw_senders_close(void)
+{
+   int i;
+   for (i = 0; i < g_sender_count; i++)
+   {
+      oshw_sender_t *s = g_senders[i];
+      g_senders[i] = NULL;
+      if (s == NULL) continue;
+      InterlockedExchange(&s->stop, 1);
+      if (s->go) SetEvent(s->go);
+      if (s->thread && WaitForSingleObject(s->thread, 5000) != WAIT_OBJECT_0)
+      {
+         /* Still inside a write the driver never completed. Closing its
+          * pcap handle or freeing its slot under it would be a use after
+          * free, so leave both to the thread and leak them: the stop is
+          * signalled, so it ends when the write returns, and no later open
+          * reuses this allocation. The adapter is closed and reopened in
+          * the same process (a bus re-open), so this is not only exit. */
+         CloseHandle(s->thread);
+         continue;
+      }
+      if (s->thread) CloseHandle(s->thread);
+      if (s->go) CloseHandle(s->go);
+      if (s->sock) pcap_close(s->sock);
+      free(s);
+   }
+   g_sender_count = 0;
+   g_tagging = 0;
+}
+
+static void oshw_senders_open(const char *ifname)
+{
+   int i;
+   struct bpf_program none;
+   oshw_senders_close();
+   if (!oshw_async_send) return;
+   QueryPerformanceFrequency(&g_qpf);
+   for (i = 0; i < OSHW_SENDERS; i++)
+   {
+      oshw_sender_t *s = (oshw_sender_t *)calloc(1, sizeof(*s));
+      if (s == NULL) break;
+      /* send only: a small kernel buffer and a filter that keeps nothing */
+      s->sock = pcap_open(ifname, 65536, PCAP_OPENFLAG_NOCAPTURE_LOCAL, -1, NULL, errbuf);
+      if (s->sock == NULL) { free(s); break; }
+      pcap_setbuff(s->sock, 16384);
+      if (pcap_compile(s->sock, &none, "less 1", 1, 0) == 0)
+      {
+         pcap_setfilter(s->sock, &none);
+         pcap_freecode(&none);
+      }
+      s->go = CreateEvent(NULL, FALSE, FALSE, NULL);
+      s->thread = (s->go != NULL) ? CreateThread(NULL, 0, oshw_sender_main, s, 0, NULL) : NULL;
+      if (s->thread == NULL)
+      {
+         if (s->go) CloseHandle(s->go);
+         pcap_close(s->sock);
+         free(s);
+         break;
+      }
+      SetThreadPriority(s->thread, THREAD_PRIORITY_TIME_CRITICAL);
+      g_senders[i] = s;
+      g_sender_count = i + 1;
+   }
+   memset(g_tag, 0, sizeof(g_tag));
+   g_tagging = (g_sender_count > 0);
+}
+
+/* With the frames leaving through other handles, the receive handle sees the
+ * driver's loop-back copies of our own transmissions (an open skips only its
+ * own sends). A frame that has passed a slave comes back with the source
+ * address's locally administered bit set (every EtherCAT slave chip does
+ * this), so the unprocessed copies are the frames carrying our source
+ * address with that bit clear (bytes 4-5 hold the sequence tag, so only the
+ * first four bytes are compared): a filter in the driver drops them, and
+ * the receive path checks again in case the filter could not be set. */
+static void oshw_mac_bytes(const uint16 *mac, unsigned char *out)
+{
+   int i;
+   for (i = 0; i < 3; i++) { out[2 * i] = (unsigned char)(mac[i] >> 8); out[2 * i + 1] = (unsigned char)(mac[i] & 0xff); }
+}
+
+static int oshw_own_source(const unsigned char *sa)
+{
+   unsigned char p[6], s[6];
+   oshw_mac_bytes(priMAC, p);
+   oshw_mac_bytes(secMAC, s);
+   return (memcmp(sa, p, 4) == 0) || (memcmp(sa, s, 4) == 0);
+}
+
+static void oshw_drop_own_frames(pcap_t *sock)
+{
+   struct bpf_program fp;
+   unsigned char p[6], s[6];
+   char expr[160];
+   oshw_mac_bytes(priMAC, p);
+   oshw_mac_bytes(secMAC, s);
+   sprintf(expr, "not ether[6:4] = 0x%02x%02x%02x%02x and not ether[6:4] = 0x%02x%02x%02x%02x",
+           p[0], p[1], p[2], p[3], s[0], s[1], s[2], s[3]);
+   if (pcap_compile(sock, &fp, expr, 1, 0) == 0)
+   {
+      pcap_setfilter(sock, &fp);
+      pcap_freecode(&fp);
+   }
+}
+
+/* Hand a frame to a free sender: 0 = handed over, -1 = every sender busy. */
+static int oshw_send_async(const uint8 *frame, int len)
+{
+   int k;
+   LARGE_INTEGER t0, t1;
+   for (k = 0; k < g_sender_count; k++)
+   {
+      oshw_sender_t *s = g_senders[(g_sender_next + k) % g_sender_count];
+      if (InterlockedCompareExchange(&s->busy, 1, 0) != 0) continue;
+      g_sender_next = (unsigned)((g_sender_next + k + 1) % g_sender_count);
+      memcpy(s->buf, frame, len);
+      s->len = len;
+      InterlockedExchange(&s->started, 0);
+      SetEvent(s->go);
+      /* until the sender is in its write, so the next frame cannot overtake this one */
+      QueryPerformanceCounter(&t0);
+      while (!s->started)
+      {
+         YieldProcessor();
+         QueryPerformanceCounter(&t1);
+         if ((t1.QuadPart - t0.QuadPart) * 1000000 / g_qpf.QuadPart > OSHW_SEND_START_WAIT_US)
+         {
+            InterlockedIncrement((volatile LONG *)&oshw_async_stats[2]);
+            break;
+         }
+      }
+      InterlockedIncrement((volatile LONG *)&oshw_async_stats[0]);
+      return 0;
+   }
+   return -1;
+}
